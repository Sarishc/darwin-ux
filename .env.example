# DarwinUX environment template
#
# Copy to `.env` (git-ignored) and fill in locally:   cp .env.example .env
# This file is committed. It must NEVER contain real values — only names,
# safe defaults, and comments. Nothing reads these variables yet (Step 1).
#
# DarwinUX's own settings use the DARWIN_ prefix. Standard third-party
# names (AWS_*, OTEL_*) are used where a library already expects them.

# ---- Application -----------------------------------------------------------
DARWIN_ENV=local
DARWIN_LOG_LEVEL=INFO

# ---- Database: local PostgreSQL 17 (Homebrew) ------------------------------
# LOCAL ONLY values — `make db-setup` creates exactly this role, password and
# databases on your machine. They are not secrets. Production uses AWS RDS with
# credentials from Secrets Manager, never this file.
# Driver scheme must be postgresql+psycopg (psycopg 3).
DARWIN_DATABASE_URL=postgresql+psycopg://darwin:darwin_local_only@localhost:5432/darwin_dev
# Integration tests only. Enforced: host must be local, database must end in _test.
DARWIN_TEST_DATABASE_URL=postgresql+psycopg://darwin:darwin_local_only@localhost:5432/darwin_test

# ---- Browser access (Step 7+) -----------------------------------------------
# Exact origins allowed to call the API from a browser (comma-separated).
# Unset -> the local Next.js dev server: http://localhost:3000,http://127.0.0.1:3000
# Never "*".
# DARWIN_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- LLM provider (Step 4+) ------------------------------------------------
# Provider not chosen yet (OPEN_QUESTIONS.md N1). Step 9 uses only the built-in
# FakeLLMProvider and reads none of these; a real adapter will define its settings.
DARWIN_LLM_PROVIDER=
DARWIN_LLM_MODEL=
DARWIN_LLM_API_KEY=

# ---- LangGraph / LangSmith (Step 10+) --------------------------------------
# langchain-core ships the LangSmith tracing client. Do NOT enable it
# (LANGSMITH_TRACING / LANGCHAIN_TRACING_V2): it would send prompts and evidence
# to a third party. DarwinUX research refuses to run while it is enabled.

# ---- Embeddings (Step 3+) --------------------------------------------------
DARWIN_EMBEDDING_PROVIDER=
DARWIN_EMBEDDING_MODEL=
DARWIN_EMBEDDING_API_KEY=

# ---- Jev decision layer (Step 11) --------------------------------------------
# The decider is chosen per command (make decision-run DECIDER=rules|fake|llm|jev).
# DECIDER=jev calls TypeSafe's documented HTTP API (docs.typesafe.ai/api) with a
# TypeSafe API key as a Bearer token. Optional: leave empty and DECIDER=jev stops
# with a clear message (no fallback). The variable names are DarwinUX's own.
DARWIN_JEV_API_KEY=
DARWIN_JEV_MODEL=jev-latest

# ---- Muse generative mutation layer (Step 5+) ------------------------------
# Selects which DarwinUX adapter implements the Muse port: fixture | llm_baseline
# ("muse" becomes valid only after the real integration exists).
DARWIN_MUTATION_GENERATOR_ADAPTER=fixture
# Muse connection settings: TBD. Muse's provider, access method and credential
# names are unverified (OPEN_QUESTIONS.md B2). Do not invent them here.

# ---- AWS (Step 9+) ---------------------------------------------------------
# Not needed for local development. Prefer a named profile (`aws configure sso`)
# over access keys; never put access keys in this file.
# AWS_PROFILE=
# AWS_REGION=

# ---- Observability (Step 16) -----------------------------------------------
# OpenTelemetry traces + metrics. OFF by default; DarwinUX never depends on them.
# console: compact span/metric lines on stderr (local, no collector needed).
# otlp:    OTLP/HTTP to DARWIN_OTEL_ENDPOINT (e.g. a future ADOT collector).
# Service names are fixed per process (darwin-api / darwin-worker / darwin-cli).
# Never put credentials in the endpoint (it is validated: no user:pass, no query).
DARWIN_OTEL_ENABLED=false
DARWIN_OTEL_EXPORTER=console
# DARWIN_OTEL_ENDPOINT=http://localhost:4318
DARWIN_OTEL_SAMPLE_RATIO=1.0
DARWIN_OTEL_METRIC_INTERVAL_SECONDS=60
