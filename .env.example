# DarwinUX environment template
#
# Copy to `.env` (git-ignored) and fill in locally:   cp .env.example .env
# This file is committed. It must NEVER contain real values — only names,
# safe defaults, and comments. Nothing reads these variables yet (Step 1).
#
# DarwinUX's own settings use the DARWIN_ prefix. Standard third-party
# names (AWS_*, OTEL_*) are used where a library already expects them.

# ---- Application -----------------------------------------------------------
DARWIN_ENV=local
DARWIN_LOG_LEVEL=INFO

# ---- Database (Step 2+) ----------------------------------------------------
# Local Postgres from docker compose, once it exists. Local-only credentials.
DARWIN_DATABASE_URL=

# ---- LLM provider (Step 4+) ------------------------------------------------
# Provider not chosen yet (OPEN_QUESTIONS.md N1).
DARWIN_LLM_PROVIDER=
DARWIN_LLM_MODEL=
DARWIN_LLM_API_KEY=

# ---- Embeddings (Step 3+) --------------------------------------------------
DARWIN_EMBEDDING_PROVIDER=
DARWIN_EMBEDDING_MODEL=
DARWIN_EMBEDDING_API_KEY=

# ---- Jev decision layer (Step 5+) ------------------------------------------
# Selects which DarwinUX adapter implements the Jev port: rules | llm_baseline
# ("jev" becomes valid only after the real integration exists).
DARWIN_DECIDER_ADAPTER=rules
# Jev connection settings: TBD. Jev's official access method and credential
# names are unverified (OPEN_QUESTIONS.md B1). Do not invent them here.

# ---- Muse generative mutation layer (Step 5+) ------------------------------
# Selects which DarwinUX adapter implements the Muse port: fixture | llm_baseline
# ("muse" becomes valid only after the real integration exists).
DARWIN_MUTATION_GENERATOR_ADAPTER=fixture
# Muse connection settings: TBD. Muse's provider, access method and credential
# names are unverified (OPEN_QUESTIONS.md B2). Do not invent them here.

# ---- AWS (Step 9+) ---------------------------------------------------------
# Not needed for local development. Prefer a named profile (`aws configure sso`)
# over access keys; never put access keys in this file.
# AWS_PROFILE=
# AWS_REGION=

# ---- Observability (Step 2+) ----------------------------------------------
# Standard OpenTelemetry variables, read by the OTel SDK once it is added.
# OTEL_SERVICE_NAME=darwin-api
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
