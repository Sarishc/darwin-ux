    {
      "id": "rage_click_accept",
      "description": "Rage click on the delayed Team Pro CTA: one retrieval is enough, the hypothesis is critiqued and accepted.",
      "signal_type": "rage_click",
      "component": "plan_team_pro_cta",
      "expected": {
        "status": "succeeded",
        "stop_reason": "critique_accept",
        "trajectory": [
          "load_signal",
          "retrieve",
          "assess_evidence",
          "generate_hypothesis",
          "critique_hypothesis",
          "finalize"
        ],
        "forbidden_nodes": [
          "refine_query",
          "human_review"
        ],
        "retrieval_attempts": 1,
        "llm_calls": 2,
        "hypothesis": "accepted",
        "one_retrieval_is_enough": true
      }
    },
    {
