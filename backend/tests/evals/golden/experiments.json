          "rage_click_session_rate": 10
        }
      },
      "candidate": {
        "exposed": 120,
        "outcomes": {
          "signup_submit_session_rate": 60,
          "form_error_session_rate": 12,
          "rage_click_session_rate": 10
        }
      },
      "expected": {
        "assessment": "evidence_ready",
        "difference_sign": "positive"
      }
    },
