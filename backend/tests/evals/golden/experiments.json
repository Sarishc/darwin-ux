      "timeline": [
        {
          "do": "expose",
          "minute": 10,
          "session": 0
        },
        {
          "do": "pause",
          "minute": 30,
          "session": 0
        },
        {
          "do": "rage",
          "minute": 35,
          "session": 0
        },
        {
          "do": "form_error",
          "minute": 36,
          "session": 0
        },
        {
          "do": "resume",
          "minute": 45,
          "session": 0
