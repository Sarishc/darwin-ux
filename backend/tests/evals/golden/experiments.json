          "signup_submit_session_rate": 40
        }
      },
      "expected": {
        "assessment": "evidence_ready",
        "difference_sign": "positive"
      }
    },
    {
      "id": "ana_higher_is_better_primary",
      "kind": "analysis",
      "description": "A higher-is-better primary (signup submits) that the candidate raises is still only evidence.",
      "config": {
        "primary_metric": "signup_submit_session_rate",
        "guardrail_metrics": [
          "form_error_session_rate",
          "rage_click_session_rate"
        ]
      },
      "control": {
        "exposed": 120,
        "outcomes": {
          "signup_submit_session_rate": 36,
