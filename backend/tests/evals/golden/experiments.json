{
  "version": 1,
  "cases": [
    {
      "id": "elig_pass_eligible",
      "kind": "eligibility",
      "description": "A real Step 13 pass candidate can be drafted and explicitly started.",
      "expected": {
        "created": true,
        "started": true
      }
    },
    {
      "id": "elig_reject_refused",
      "kind": "eligibility",
      "description": "A Step 13 reject (the harmful-but-safe candidate) can never become an experiment.",
      "evaluation": "reject",
      "expected": {
        "created": false,
        "started": false,
        "reasons_include": [
          "evaluation_not_pass"
        ]
      }
    },
    {
      "id": "elig_human_review_refused",
      "kind": "eligibility",
      "description": "A Step 13 human_review (unrelated change) is not eligible for an experiment.",
      "evaluation": "human_review",
      "expected": {
        "created": false,
        "started": false,
        "reasons_include": [
          "evaluation_not_pass"
        ]
      }
    },
    {
      "id": "elig_missing_evaluation",
      "kind": "eligibility",
      "description": "An evaluation id that does not exist is refused, not trusted.",
      "evaluation": "missing",
      "expected": {
        "created": false,
        "started": false,
        "reasons_include": [
          "evaluation_not_found"
        ]
      }
    },
    {
      "id": "elig_forged_pass_tampered_candidate",
      "kind": "eligibility",
      "description": "A forged pass record for a candidate whose stored hash does not match its content is refused by the provenance re-check.",
      "corrupt": "forged_pass_on_tampered_candidate",
      "expected": {
        "created": false,
        "started": false,
        "reasons_include": [
          "provenance_invalid",
          "candidate_hash_mismatch"
        ]
      }
    },
    {
      "id": "elig_forged_pass_category_fail",
      "kind": "eligibility",
      "description": "A record that claims pass while a category did not pass is refused.",
      "corrupt": "forged_pass_category_fail",
      "expected": {
        "created": false,
        "started": false,
        "reasons_include": [
          "evaluation_category_not_pass"
        ]
      }
    },
    {
      "id": "elig_newer_non_pass",
      "kind": "eligibility",
      "description": "A pass that was later superseded by a reject evaluation of the same candidate is refused.",
      "corrupt": "newer_non_pass",
      "expected": {
        "created": false,
        "started": false,
        "reasons_include": [
          "superseded_by_newer_evaluation"
        ]
      }
    },
    {
      "id": "elig_candidate_hash_mismatch",
      "kind": "eligibility",
      "description": "A draft that claims a different candidate than the one Step 13 evaluated cannot start.",
      "corrupt": "draft_claims_other_candidate",
      "expected": {
        "created": true,
        "started": false,
        "reasons_include": [
          "candidate_changed_since_evaluation"
        ]
      }
    },
    {
      "id": "elig_control_not_generation_zero",
      "kind": "eligibility",
      "description": "A draft whose control hash is not Generation 0 cannot start.",
      "corrupt": "draft_control_not_gen0",
      "expected": {
        "created": true,
        "started": false,
        "reasons_include": [
          "control_not_generation_zero"
        ]
      }
    },
    {
      "id": "elig_already_running",
      "kind": "eligibility",
      "description": "Starting a running experiment again is refused.",
      "corrupt": "start_twice",
      "expected": {
        "created": true,
        "started": false,
        "reasons_include": [
          "experiment_already_running"
        ]
      }
    },
    {
      "id": "elig_another_active",
      "kind": "eligibility",
      "description": "A second experiment on a page that already has an active one cannot start.",
      "corrupt": "another_active",
      "expected": {
        "created": true,
        "started": false,
        "reasons_include": [
          "another_experiment_active"
        ]
      }
    },
    {
      "id": "fail_invalid_metric",
      "kind": "eligibility",
      "description": "A free-form primary metric name is refused before anything is stored.",
      "config": {
        "primary_metric": "conversion_rate"
      },
      "expected": {
        "created": false,
        "started": false,
        "reasons_include": [
          "primary_metric_unknown"
        ]
      }
    },
    {
      "id": "fail_invalid_guardrail",
      "kind": "eligibility",
      "description": "A guardrail equal to the primary metric is refused.",
      "config": {
        "guardrail_metrics": [
          "rage_click_session_rate"
        ]
      },
      "expected": {
        "created": false,
        "started": false,
        "reasons_include": [
          "primary_metric_is_guardrail"
        ]
      }
    },
    {
      "id": "fail_no_guardrails",
      "kind": "eligibility",
      "description": "An experiment without guardrails is refused.",
      "config": {
        "guardrail_metrics": []
      },
      "expected": {
        "created": false,
        "started": false,
        "reasons_include": [
          "guardrails_missing_or_too_many"
        ]
      }
    },
    {
      "id": "fail_allocation_not_allowlisted",
      "kind": "eligibility",
      "description": "A 60% candidate allocation is refused.",
      "config": {
        "candidate_allocation_bp": 6000
      },
      "expected": {
        "created": false,
        "started": false,
        "reasons_include": [
          "allocation_not_allowlisted"
        ]
      }
    },
    {
      "id": "fail_min_sample_too_small",
      "kind": "eligibility",
      "description": "A minimum sample below the operational floor is refused.",
      "config": {
        "minimum_sample_per_variant": 20
      },
      "expected": {
        "created": false,
        "started": false,
        "reasons_include": [
          "minimum_sample_invalid"
        ]
      }
    },
    {
      "id": "alloc_deterministic",
      "kind": "allocation",
      "description": "Assigning the same 2000 sessions twice gives identical variants.",
      "scenario": "deterministic",
      "expected": {
        "accepted": true
      }
    },
    {
      "id": "alloc_same_session",
      "kind": "allocation",
      "description": "One session asked 100 times always gets the same variant.",
      "scenario": "same_session",
      "expected": {
        "accepted": true
      }
    },
    {
      "id": "alloc_independent_experiments",
      "kind": "allocation",
      "description": "Two experiments bucket the same sessions independently (about 50% agreement at 50/50).",
      "scenario": "independent_experiments",
      "expected": {
        "accepted": true
      }
    },
    {
      "id": "alloc_allowed_values",
      "kind": "allocation",
      "description": "Every allowlisted allocation is accepted and yields its configured share within 1 point over 20000 sessions.",
      "scenario": "allowed_values",
      "expected": {
        "accepted": true
      }
    },
    {
      "id": "alloc_invalid_values",
      "kind": "allocation",
      "description": "Zero, 100%, 51-99%, negative, float, boolean and string allocations are all refused.",
      "scenario": "invalid_values",
      "values": [
        0,
        10000,
        5100,
        9999,
        -100,
        1000.0,
        true,
        "1000",
        null,
        99,
        101
      ],
      "expected": {
        "accepted": false
      }
    },
    {
      "id": "alloc_boundary",
      "kind": "allocation",
      "description": "The candidate gets exactly the buckets below the allocation and never one above it.",
      "scenario": "boundary",
      "expected": {
        "accepted": true
      }
    },
    {
      "id": "exp_assignment_only",
      "kind": "exposure",
      "description": "Sessions that were assigned but never reported a render are not exposures.",
      "scenario": "assignment_only",
      "expected": {
        "exposures": {
          "control": 0,
          "candidate": 0
        }
      }
    },
    {
      "id": "exp_counts_after_render",
      "kind": "exposure",
      "description": "Each session that reports a successful render counts once in its assigned variant.",
      "scenario": "exposed_after_render",
      "expected": {
        "exposures": {
          "control": 5,
          "candidate": 5
        }
      }
    },
    {
      "id": "exp_duplicate_idempotent",
      "kind": "exposure",
      "description": "Three exposure events per session still count once.",
      "scenario": "duplicate",
      "expected": {
        "exposures": {
          "control": 5,
          "candidate": 5
        }
      }
    },
    {
      "id": "exp_wrong_variant_rejected",
      "kind": "exposure",
      "description": "An exposure claiming a variant the session was not assigned is not counted.",
      "scenario": "wrong_variant",
      "expected": {
        "exposures": {
          "control": 0,
          "candidate": 0
        }
      }
    },
    {
      "id": "exp_wrong_hash_rejected",
      "kind": "exposure",
      "description": "An exposure with a spec hash that is not the variant's is not counted.",
      "scenario": "wrong_hash",
      "expected": {
        "exposures": {
          "control": 0,
          "candidate": 0
        }
      }
    },
    {
      "id": "exp_not_running",
      "kind": "exposure",
      "description": "Exposures for a draft (not started) experiment are not counted.",
      "scenario": "not_running",
      "expected": {
        "exposures": {
          "control": 0,
          "candidate": 0
        }
      }
    },
    {
      "id": "ana_insufficient",
      "kind": "analysis",
      "description": "40 exposed sessions per variant is below the 100 floor: insufficient_data, whatever the rates.",
      "control": {
        "exposed": 40,
        "outcomes": {
          "rage_click_session_rate": 12
        }
      },
      "candidate": {
        "exposed": 40,
        "outcomes": {
          "rage_click_session_rate": 2
        }
      },
      "expected": {
        "assessment": "insufficient_data",
        "reasons_include": [
          "insufficient_samples"
        ]
      }
    },
    {
      "id": "ana_equal",
      "kind": "analysis",
      "description": "Identical outcomes: evidence ready, zero difference.",
      "control": {
        "exposed": 120,
        "outcomes": {
          "rage_click_session_rate": 30,
          "form_error_session_rate": 12,
          "signup_submit_session_rate": 40
        }
      },
      "candidate": {
        "exposed": 120,
        "outcomes": {
          "rage_click_session_rate": 30,
          "form_error_session_rate": 12,
          "signup_submit_session_rate": 40
        }
      },
      "expected": {
        "assessment": "evidence_ready",
        "difference_sign": "zero"
      }
    },
    {
      "id": "ana_candidate_better",
      "kind": "analysis",
      "description": "Candidate numerically better on the primary (fewer rage-click sessions): evidence ready, NOT promoted.",
      "control": {
        "exposed": 120,
        "outcomes": {
          "rage_click_session_rate": 48,
          "form_error_session_rate": 12,
          "signup_submit_session_rate": 40
        }
      },
      "candidate": {
        "exposed": 120,
        "outcomes": {
          "rage_click_session_rate": 12,
          "form_error_session_rate": 12,
          "signup_submit_session_rate": 44
        }
      },
      "expected": {
        "assessment": "evidence_ready",
        "difference_sign": "negative"
      }
    },
    {
      "id": "ana_candidate_worse",
      "kind": "analysis",
      "description": "Candidate numerically worse on the primary: evidence ready; the human decides.",
      "control": {
        "exposed": 120,
        "outcomes": {
          "rage_click_session_rate": 12,
          "form_error_session_rate": 12,
          "signup_submit_session_rate": 40
        }
      },
      "candidate": {
        "exposed": 120,
        "outcomes": {
          "rage_click_session_rate": 24,
