    {
      "id": "win_running_exposure_counted",
      "kind": "window",
      "description": "An exposure that happens and is processed while running is counted.",
      "timeline": [
        {
          "do": "expose",
          "minute": 10,
          "session": 0
        }
      ],
      "expected": {
        "exposures": {
          "control": 0,
          "candidate": 1
        },
        "windows": 1
      }
    },
    {
      "id": "paused_exposure_refused",
      "kind": "window",
      "description": "Exposures processed after a pause are refused: a delayed one from before the pause, one during it, and one arriving after resume that happened during the pause.",
      "timeline": [
        {
          "do": "pause",
          "minute": 30,
          "session": 0
        },
        {
          "do": "expose",
          "minute": 10,
          "session": 0
        },
        {
          "do": "expose",
          "minute": 35,
          "session": 1
        },
        {
          "do": "resume",
          "minute": 45,
          "session": 0
        },
        {
          "do": "expose",
          "minute": 40,
          "session": 2
        }
      ],
      "expected": {
        "exposures": {
          "control": 0,
          "candidate": 0
        },
        "windows": 2
      }
    },
    {
      "id": "terminal_exposure_refused",
      "kind": "window",
      "description": "An exposure processed after completion is refused, even if it happened while running.",
      "timeline": [
        {
          "do": "complete",
          "minute": 30,
          "session": 0
        },
        {
          "do": "expose",
          "minute": 10,
          "session": 0
        }
      ],
      "expected": {
        "exposures": {
          "control": 0,
          "candidate": 0
        },
        "windows": 1
      }
    },
    {
