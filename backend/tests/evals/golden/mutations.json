{
  "version": 1,
  "cases": [
    {
      "id": "rage_click_feedback_fix",
      "description": "Rage click on the delayed Team Pro CTA: the fix is immediate feedback.",
      "expected": {
        "status": "succeeded",
        "changes": [
          {
            "component_id": "plan_team_pro_cta",
            "property": "feedback",
            "value": "immediate"
          }
        ]
      }
    },
    {
      "id": "error_burst_inline_and_per_field",
      "description": "Error burst on the signup form: validate inline and show per-field errors.",
      "expected": {
        "status": "succeeded",
        "changes": [
          {
            "component_id": "signup_form",
            "property": "validation",
            "value": "inline"
          },
          {
            "component_id": "signup_form",
            "property": "error_display",
            "value": "per_field"
          }
        ]
      },
      "artifact": {
        "signal_type": "error_burst",
        "affected_component": "signup_form",
        "statement": "Repeated errors on signup_form suggest its validation requirements are not clear before submission."
      },
      "llm_expected": {
        "status": "succeeded"
      }
    },
    {
      "id": "error_burst_inline_only",
      "description": "Error burst: only switch validation to inline.",
      "expected": {
        "status": "succeeded",
        "changes": [
          {
            "component_id": "signup_form",
            "property": "validation",
            "value": "inline"
          }
        ]
      },
      "artifact": {
        "signal_type": "error_burst",
        "affected_component": "signup_form",
        "statement": "Repeated errors on signup_form suggest its validation requirements are not clear before submission."
      },
      "fixture_mode": "inline_only",
      "llm_expected": {
        "status": "succeeded"
      }
    },
    {
      "id": "error_burst_per_field_only",
      "description": "Error burst: only switch errors to per-field display.",
      "expected": {
        "status": "succeeded",
        "changes": [
          {
            "component_id": "signup_form",
            "property": "error_display",
            "value": "per_field"
          }
        ]
      },
      "artifact": {
        "signal_type": "error_burst",
        "affected_component": "signup_form",
        "statement": "Repeated errors on signup_form suggest its validation requirements are not clear before submission."
      },
      "fixture_mode": "per_field_only",
      "llm_expected": {
        "status": "succeeded"
      }
    },
    {
      "id": "text_only_safe_label",
      "description": "A safe plain-text change to the CTA label.",
      "expected": {
        "status": "succeeded",
        "changes": [
          {
            "component_id": "plan_team_pro_cta",
            "property": "label",
            "value": "Start with Team Pro"
          }
        ]
      },
      "fixture_mode": "text_only",
      "llm_expected": {
        "status": "succeeded"
      }
    },
    {
      "id": "multiple_safe_operations",
      "description": "Two safe operations: CTA feedback and plans-section spacing.",
      "expected": {
        "status": "succeeded",
        "changes": [
          {
            "component_id": "plan_team_pro_cta",
            "property": "feedback",
            "value": "immediate"
          },
          {
            "component_id": "plans",
            "property": "spacing",
            "value": "lg"
          }
        ]
      },
      "fixture_mode": "multi",
      "llm_expected": {
        "status": "succeeded"
      }
    },
    {
      "id": "unknown_component",
      "description": "The generator targets a component that does not exist.",
      "expected": {
        "status": "validation_failed",
        "error_type": "unknown_component"
      },
      "fixture_mode": "unknown_component",
      "llm_expected": {
        "status": "succeeded"
      }
    },
    {
      "id": "immutable_property_price",
      "description": "The generator tries to change a plan's price label.",
      "expected": {
        "status": "validation_failed",
        "error_type": "protected_property"
      },
      "fixture_mode": "immutable_property",
      "llm_expected": {
        "status": "succeeded"
      }
    },
    {
