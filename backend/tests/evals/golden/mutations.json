        "status": "validation_failed",
        "error_type": "property_not_mutable"
      },
      "fixture_mode": "executable",
      "llm_expected": {
        "status": "succeeded"
      }
    },
    {
      "id": "html_in_text",
      "description": "The generator puts markup into a label.",
