# DarwinUX frontend environment template. Copy to .env.local (git-ignored):
#   cp .env.example .env.local
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time.
# They are PUBLIC by definition: never put a secret here.

# Where the browser sends telemetry (the DarwinUX API; `make api` serves :8000).
# Unset or empty -> telemetry is disabled and the demo still works.
NEXT_PUBLIC_DARWIN_API_BASE_URL=http://127.0.0.1:8000
